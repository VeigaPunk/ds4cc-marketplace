#!/bin/bash
# xask — minimal routing protocol for cross-model orchestration
# Usage: xask [catalog|providers|models] --json
#        xask plan --provider <provider> [selection flags] -- "<query>"
#        xask [selection flags] <route> "<query>" ["<context>"] ["<skill>"]
#
# Routes: gemma/codex/cdx → xbreed ask; grok → grok oneshot; qwen38/ds-* → Token Plan
# wrappers; kimi → Kimi Code CLI one-shot over Moonshot's OpenAI-compatible API
# (api.moonshot.ai/v1 chat completions — no public /v1/responses, so a
# codex-profile router lane is impossible on current codex builds).
# Always-on for xbreed codex: suppression, bounded non-interactive
# dispatch, exact Godspeed forwarding, and an explicit service tier.
#
# Always-on codex exec flags (xbreed ask.rs / Token Plan live argv):
#   --skip-git-repo-check · --color never · --ephemeral · --sandbox workspace-write
#   -c approval_policy="never" · (xbreed also suppresses include_* instructions)
#
# Flags: -d (debug) | -scp (scope; was -s, renamed 2026-04-24 — -s conflicted)
#      | -r (rich) | --spk (spark) | -R (review) | -F (full) | --gpt55 (gpt-5.6-sol)
#      | --model-id (exact provider model) | --gs (explicit godspeed SKILL load) | -e (effort) | -o (output-last-message) | --json
#
# codex / cdx model lanes:
#   default:       stock ChatGPT Codex via xbreed ask (gpt-5.6-sol, service_tier=fast)
#   --spark / --substrate sekhmet: L3 sekhmet + gpt-5.3-codex-spark (fallback gpt-5.6-luna)
#   --model-id / --gpt55 / -R / -F: stock ChatGPT Codex via xbreed ask
#   --review / -R: gpt-5.6-sol stock (reviewer/critic/sentinel opt-in)
#   -R --full/-F:  gpt-5.6-sol full stock (the-revenger RECON escape hatch, 1.05M ctx)
#   --gpt55:       gpt-5.6-sol stock
#   service_tier=fast is the ChatGPT default; Daybreak / gpt-5.4-mini stay default.
#
# Native / Token Plan lanes (no xbreed ask; env -u CODEX_BIN -u XBRD_SPARK_MODEL):
#   grok:    grok --always-approve --no-subagents --verbatim -p
#   qwen38:  codex-qwen38 exec … (aliases: qwen3.8-max, qwen)
#   ds-flash / ds-pro: Token Plan debug + live wrappers (reject bare deepseek)
#   kimi:    kimi -m kimi-code/k3 -p … (aliases: kimi-k3, kimi-code;
#            reject bare moonshot). Auth lives inside kimi-code (OAuth or the
#            imported moonshotai API-key provider). Effort is envelope-text
#            only (gemini-style): no reasoning-effort flag exists; tiers
#            validated as low|high|max. Always pins -m (CLI default_model is
#            kimi-for-coding, NOT K3).
#   --spark rejected with grok|qwen38|ds-flash|ds-pro|kimi
#
# Examples:
#   xask gemma "What patterns exist?"               # local Gemma via HVM (g- prefix)
#   xask g "What patterns exist?"                   # short alias → same HVM lane
#   xask gemini "What patterns exist?"              # LEGACY alias → gemma/HVM (cloud retired)
#   xask --gs gemma "What patterns exist?"          # explicit godspeed load (SKILL override)
#   xask -scp "src/ask.rs" gemma "Review this"      # scoped clean dispatch
#   xask --spk codex "Probe this hypothesis"        # explicit sekhmet + spark + fast
#   xask codex "Probe this hypothesis"              # stock xbreed ask (not spark)
#   xask cdx "Probe this hypothesis"                # alias → stock xbreed ask
#   xask --substrate sekhmet cdx "Probe"            # opt-in L3 sekhmet
#   xask --gs grok "Probe oneshot"                  # bash-exec grok CLI
#   xask --gs qwen38 "Token Plan probe"             # bash-exec codex-qwen38
#   xask --gs kimi "Moonshot K3 probe"              # bash-exec kimi -m kimi-code/k3 (OAuth)
#   xask -R codex "Adversarial review of <diff>"    # review lane — gpt-5.6-sol
#   xask -R -F codex "RECON codebase-scale"         # -R + -F escape hatch — full gpt-5.6-sol (1.05M ctx)
#   xask --gpt55 --gs -e high codex "Deep question" # gpt-5.6-sol lane, explicit godspeed, high effort
#   xask -e high codex "Deep question"              # explicit reasoning effort
# PATH self-heal: agent-spawned non-login non-interactive shells get the minimal
# default PATH and miss ~/.local/bin, where xbreed (called by bare name below) lives.
# Real script dir first (readlink -f dereferences the /usr/local/bin shim symlink).
_XASK_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
case ":$PATH:" in *":$_XASK_DIR:"*) ;; *) PATH="$_XASK_DIR:$PATH" ;; esac
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$PATH:$HOME/.local/bin" ;; esac
export PATH

GEMINI_SETTINGS_FILE="$HOME/.gemini/settings.json"

resolve_models_exporter() {
  local candidate
  for candidate in "$_XASK_DIR/xask-models" "$(command -v xask-models 2>/dev/null || true)"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  echo "xask: xask-models exporter not found beside xask or on PATH" >&2
  return 1
}

resolve_godspeed_directive() {
  local candidate actual_hash
  for candidate in \
    "${XASK_GODSPEED_DIRECTIVE:-}" \
    "$_XASK_DIR/../skills/godspeed/directive.md" \
    "$HOME/.config/xbreed/skills/godspeed/directive.md"; do
    if [[ -n "$candidate" && -f "$candidate" && ! -L "$candidate" ]]; then
      actual_hash="$(sha256sum -- "$candidate" | awk '{print $1}')"
      if [[ "$actual_hash" == db88963cbdf5a0db22b460b284bf6f1d1f4abac9eaadb28bdb5e9bffe27be3bb ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
      echo "xask: refusing non-canonical Godspeed directive at $candidate (sha256 $actual_hash)" >&2
      return 1
    fi
  done
  echo "xask: canonical Godspeed directive.md not found (set XASK_GODSPEED_DIRECTIVE)" >&2
  return 1
}

trim_trailing_space() {
  local value="$1"
  while [[ "$value" == *[[:space:]] ]]; do value="${value%?}"; done
  printf '%s' "$value"
}

strip_trailing_godspeed_markers() {
  local value
  value="$(trim_trailing_space "$1")"
  while [[ "$value" =~ \|[[:space:]]*[Gg][Oo][Dd][Ss][Pp][Ee][Ee][Dd]$ ]]; do
    value="${value:0:${#value}-${#BASH_REMATCH[0]}}"
    value="$(trim_trailing_space "$value")"
  done
  printf '%s' "$value"
}

case "${1:-}" in
  catalog|providers|models)
    metadata_command=$1
    shift
    if [[ "${1:-}" == "--json" ]]; then shift; fi
    [[ $# -eq 0 ]] || {
      echo "xask: $metadata_command accepts only optional --json" >&2
      exit 1
    }
    models_exporter=$(resolve_models_exporter) || exit 1
    exec "$models_exporter" "$metadata_command"
    ;;
  help|--help|-h)
    cat <<'EOF'
xask — provider-aware cross-model delegation

Metadata:
  xask catalog --json
  xask providers --json
  xask models --json

Preview without execution:
  xask plan --provider chatgpt --model-id gpt-5.6-sol --effort high --json -- "task"

Dispatch:
  xask --provider chatgpt|grok|token-plan|local|moonshot \
       [--substrate stock|sekhmet] [--model-id ID] \
       [--effort low|medium|high|xhigh|max|ultra] \
       [--service-tier default|fast] [--gs] -- "task"

Legacy route tokens remain supported: codex|cdx, grok, qwen38, ds-flash,
ds-pro, gemma|g|gemini, kimi|kimi-k3.
EOF
    exit 0
    ;;
esac

# Handle flags
PLAN=false
PLAN_JSON=false
if [[ "${1:-}" == "plan" ]]; then
  PLAN=true
  shift
fi
DEBUG=false
SCOPE="entire project"
RICH=false
SPARK=false
SPARK_REQUESTED=false
REVIEW=false
FULL=false
GPT55=false
FORCE_GS=false
EFFORT=""
MODEL_ID=""
PROVIDER=""
PROVIDER_EXPLICIT=false
SUBSTRATE="stock"
SUBSTRATE_EXPLICIT=false
SERVICE_TIER=""
MODEL_FLAGS=()
OUTPUT_LAST_MESSAGE=""
EFFORT_FLAGS=()
SPARK_FLAGS=()
REVIEW_FLAGS=()
FULL_FLAGS=()
GPT55_FLAGS=()
OUTPUT_FLAGS=()
JSON_FLAGS=()
SERVICE_TIER_FLAGS=()
JSON=false
require_flag_value() {
  local flag="$1"
  if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
    echo "xask: flag '$flag' requires a value" >&2
    exit 1
  fi
}
while [[ "$1" == -* ]]; do
  case "$1" in
    --debug  | -d)   DEBUG=true; shift ;;
    --scope  | -scp) require_flag_value "$@"; SCOPE="$2"; shift 2 ;;
    --rich   | -r)   RICH=true; shift ;;
    --spark  | --spk) SPARK=true; SPARK_REQUESTED=true; shift ;;
    --review | -R)   REVIEW=true; shift ;;
    --full   | -F)   FULL=true; shift ;;
    --gpt55) GPT55=true; shift ;;
    --provider) require_flag_value "$@"; PROVIDER="$2"; PROVIDER_EXPLICIT=true; shift 2 ;;
    --substrate) require_flag_value "$@"; SUBSTRATE="$2"; SUBSTRATE_EXPLICIT=true; shift 2 ;;
    --model-id) require_flag_value "$@"; MODEL_ID="$2"; shift 2 ;;
    --service-tier) require_flag_value "$@"; SERVICE_TIER="$2"; shift 2 ;;
    --gs) FORCE_GS=true; shift ;;
    --effort | -e)   require_flag_value "$@"; EFFORT="$2"; shift 2 ;;
    --output-last-message | -o) require_flag_value "$@"; OUTPUT_LAST_MESSAGE="$2"; shift 2 ;;
    --json)
      if [[ "$PLAN" == true ]]; then PLAN_JSON=true; else JSON=true; fi
      shift
      ;;
    --) shift; break ;;
    *) echo "xask: unknown flag '$1' (run 'xask help' for the current surface)" >&2; exit 1 ;;
  esac
done

if [[ -n "$EFFORT" ]]; then
  case "$EFFORT" in
    low|medium|high|xhigh|max|ultra) ;;
    *) echo "xask: invalid effort level '$EFFORT' (use low|medium|high|xhigh|max|ultra)" >&2; exit 1 ;;
  esac
fi

case "$SUBSTRATE" in
  stock|sekhmet) ;;
  *) echo "xask: invalid substrate '$SUBSTRATE' (use stock|sekhmet)" >&2; exit 1 ;;
esac
case "$SERVICE_TIER" in
  ""|default|fast|priority) ;;
  *) echo "xask: invalid service tier '$SERVICE_TIER' (use default|fast)" >&2; exit 1 ;;
esac
[[ "$SERVICE_TIER" == priority ]] && SERVICE_TIER=fast
# Honor --spark before provider model defaults so chatgpt + --spark is
# gpt-5.3-codex-spark, not stock sol.
[[ "$SPARK_REQUESTED" == true ]] && SUBSTRATE=sekhmet

if [ -n "$MODEL_ID" ] && { [ "$REVIEW" = true ] || [ "$FULL" = true ] || [ "$GPT55" = true ]; }; then
  echo "xask: --model-id cannot be combined with --review, --full, or --gpt55" >&2
  exit 1
fi
REQUESTED_MODEL_ID="$MODEL_ID"
if [[ -n "$PROVIDER" ]]; then
  case "$PROVIDER" in
    openai|codex) PROVIDER=chatgpt ;;
    chatgpt|grok|token-plan|local|moonshot) ;;
    *) echo "xask: invalid provider '$PROVIDER' (use chatgpt|grok|token-plan|local|moonshot)" >&2; exit 1 ;;
  esac
  QUERY="${1:-}"
  CONTEXT="${2:-No prior context.}"
  REQUESTED_SKILL="${3:-}"
  case "$PROVIDER" in
    chatgpt)
      MODEL=codex
      if [[ -z "$MODEL_ID" ]]; then
        if [[ "$SUBSTRATE" == sekhmet ]]; then
          MODEL_ID="gpt-5.3-codex-spark"
        else
          MODEL_ID="gpt-5.6-sol"
        fi
      fi
      ;;
    grok)
      MODEL=grok
      MODEL_ID="${MODEL_ID:-grok-4.6}"
      ;;
    token-plan)
      token_plan_id="${MODEL_ID:-qwen3.8-max}"
      case "$token_plan_id" in
        qwen3.8-max|qwen38|qwen) MODEL=qwen38 ;;
        deepseek-v4-flash-0731|ds-flash) MODEL=ds-flash ;;
        deepseek-v4-pro-0813|ds-pro) MODEL=ds-pro ;;
        *) echo "xask: unknown Token Plan model '$token_plan_id'" >&2; exit 1 ;;
      esac
      MODEL_ID=""
      ;;
    local)
      MODEL=gemma
      MODEL_ID="${MODEL_ID:-gemma4:26b}"
      ;;
    moonshot)
      MODEL=kimi
      # MODEL_ID stays user-owned (like grok): empty → dispatch pins the K3 alias.
      ;;
  esac
else
  MODEL="${1:-}"
  QUERY="${2:-}"
  CONTEXT="${3:-No prior context.}"
  REQUESTED_SKILL="${4:-}"
fi

# Godspeed is invariant, not an optional route. A legacy positional skill is
# additive; it can never replace the canonical Godspeed loadout.
SKILL="godspeed"
if [[ -n "$REQUESTED_SKILL" && "$REQUESTED_SKILL" != godspeed ]]; then
  SKILL="godspeed,$REQUESTED_SKILL"
fi

# UI callers include the required terminal closer in their task argv. Strip it
# before template rendering, then append one closer to the final delegation
# prompt so it cannot appear both inside the Goal block and at the envelope end.
QUERY="$(strip_trailing_godspeed_markers "$QUERY")"

[[ -n "$MODEL" && -n "$QUERY" ]] || {
  echo "Usage: xask --provider <provider> [selection flags] -- \"<query>\"" >&2
  echo "       xask [flags] <route> \"<query>\"" >&2
  exit 1
}

# Validate MODEL before template construction to prevent path traversal
# (previously: `xask -d ../../docs/xask-protocol probe` would exfil docs via
# debug-mode early exit). Whitelist approach — matches the dispatch case below.
# gemma|g|gemini → HVM; codex|cdx → xbreed ask codex; grok → grok CLI;
# qwen38 (+aliases) / ds-flash / ds-pro → Token Plan; kimi (+aliases) → Kimi
# Code CLI over Moonshot API. Reject bare deepseek and bare moonshot.
case "$MODEL" in
  gemma|g|gemini|codex|cdx|grok|qwen38|qwen3.8-max|qwen|ds-flash|ds-pro|kimi|kimi-k3|kimi-code) ;;
  deepseek)
    echo "xask: unknown model 'deepseek' (use ds-flash or ds-pro)." >&2
    exit 1
    ;;
  moonshot)
    echo "xask: ambiguous route 'moonshot' (use kimi or kimi-code)." >&2
    exit 1
    ;;
  *)
    echo "xask: unknown model '$MODEL'. Use gemma (g), codex/cdx, grok, qwen38, ds-flash, kimi, or ds-pro." >&2
    exit 1
    ;;
esac

# Canonicalize Token Plan aliases; keep cdx as display name (DISPATCH_MODEL=codex).
case "$MODEL" in
  qwen3.8-max|qwen) MODEL=qwen38 ;;
  kimi-k3|kimi-code) MODEL=kimi ;;
esac

if [[ -z "$PROVIDER" ]]; then
  case "$MODEL" in
    codex|cdx) PROVIDER=chatgpt ;;
    grok) PROVIDER=grok ;;
    qwen38|ds-flash|ds-pro) PROVIDER=token-plan ;;
    kimi) PROVIDER=moonshot ;;
    gemma|g|gemini) PROVIDER=local ;;
  esac
fi

# ChatGPT default lane is stock xbreed. Spark/sekhmet is opt-in via --spark
# or --substrate sekhmet so grok/qwen/kimi/gemma dispatch is never forced
# through xbrd-spark namespaces.
if [[ "$SUBSTRATE" == sekhmet ]]; then
  [[ "$PROVIDER" == chatgpt ]] || {
    echo "xask: sekhmet substrate is available only for the chatgpt provider" >&2
    exit 1
  }
  SPARK=true
  SPARK_REQUESTED=true
fi
[[ "$SPARK_REQUESTED" == true ]] && SUBSTRATE=sekhmet

case "$PROVIDER" in
  chatgpt)
    if [[ "$SUBSTRATE" == sekhmet ]]; then
      SELECTED_MODEL_ID="${MODEL_ID:-gpt-5.3-codex-spark}"
    else
      SELECTED_MODEL_ID="${MODEL_ID:-gpt-5.6-sol}"
    fi
    ;;
  grok)
    SELECTED_MODEL_ID="${MODEL_ID:-grok-4.6}"
    ;;
  token-plan)
    case "$MODEL" in
      qwen38) SELECTED_MODEL_ID=qwen3.8-max ;;
      ds-flash) SELECTED_MODEL_ID=deepseek-v4-flash-0731 ;;
      ds-pro) SELECTED_MODEL_ID=deepseek-v4-pro-0813 ;;
    esac
    ;;
  local)
    SELECTED_MODEL_ID="${MODEL_ID:-gemma4:26b}"
    ;;
  moonshot)
    SELECTED_MODEL_ID="${MODEL_ID:-kimi-k3}"
    ;;
esac

# The normalized provider interface is catalog-bound. Legacy route syntax
# keeps accepting provider-native overrides, but UI/MCP callers must not be
# able to pair (for example) a ChatGPT slug with the Grok transport.
if [[ "$PROVIDER_EXPLICIT" == true ]]; then
  model_matches_provider=false
  case "$PROVIDER:$SELECTED_MODEL_ID" in
    chatgpt:gpt-5.6-sol|chatgpt:gpt-5.6-terra|chatgpt:gpt-5.6-luna|\
    chatgpt:gpt-daybreak-blue-latest|chatgpt:gpt-reserve|chatgpt:gpt-5.5|\
    chatgpt:gpt-5.4|chatgpt:gpt-5.4-mini|chatgpt:gpt-5.3-codex-spark|\
    chatgpt:codex-auto-review|grok:grok-4.6|grok:grok-4.5|\
    token-plan:qwen3.8-max|token-plan:deepseek-v4-flash-0731|\
    token-plan:deepseek-v4-pro-0813|local:gemma4:26b|moonshot:kimi-k3)
      model_matches_provider=true
      ;;
  esac
  [[ "$model_matches_provider" == true ]] || {
    echo "xask: model '$SELECTED_MODEL_ID' is not registered for provider '$PROVIDER'" >&2
    exit 1
  }
fi

# Provider-mode calls are fully normalized: omitted effort becomes the model's
# advertised default instead of inheriting an incompatible host-level setting.
if [[ "$PROVIDER_EXPLICIT" == true && -z "$EFFORT" ]]; then
  if [[ "$SUBSTRATE" == sekhmet ]]; then
    EFFORT=low
  else
    case "$SELECTED_MODEL_ID" in
    gpt-5.6-sol|gpt-daybreak-blue-latest) EFFORT=low ;;
    gpt-5.6-terra|gpt-5.6-luna|gpt-reserve|gpt-5.5|gpt-5.4|gpt-5.4-mini|codex-auto-review|deepseek-v4-flash-0731|gemma4:26b) EFFORT=medium ;;
    gpt-5.3-codex-spark|grok-4.6|grok-4.5) EFFORT=high ;;
    qwen3.8-max|deepseek-v4-pro-0813) EFFORT=xhigh ;;
    kimi-k3) EFFORT=high ;;
    esac
  fi
fi

if [[ -z "$SERVICE_TIER" ]]; then
  case "$SELECTED_MODEL_ID" in
    gpt-daybreak-blue-latest|gpt-5.4-mini) SERVICE_TIER=default ;;
    *) SERVICE_TIER=fast ;;
  esac
fi

# Pin Grok's selected default so plan output and execution cannot drift when
# the ambient Grok CLI changes its own default model.
if [[ "$PROVIDER" == grok && -z "$MODEL_ID" ]]; then
  MODEL_ID="$SELECTED_MODEL_ID"
fi

# Validate effort against the selected model rather than a global four-tier enum.
if [[ -n "$EFFORT" ]]; then
  supported=false
  case "$SELECTED_MODEL_ID" in
    gpt-5.6-sol|gpt-5.6-terra|gpt-daybreak-blue-latest|gemma4:26b)
      [[ "$EFFORT" =~ ^(low|medium|high|xhigh|max|ultra)$ ]] && supported=true
      ;;
    gpt-5.6-luna|gpt-reserve|codex-auto-review)
      [[ "$EFFORT" =~ ^(low|medium|high|xhigh|max)$ ]] && supported=true
      ;;
    gpt-5.5|gpt-5.4|gpt-5.4-mini|gpt-5.3-codex-spark|grok-4.6)
      [[ "$EFFORT" =~ ^(low|medium|high|xhigh)$ ]] && supported=true
      ;;
    grok-4.5)
      [[ "$EFFORT" =~ ^(low|medium|high)$ ]] && supported=true
      ;;
    kimi-k3)
      # Moonshot K3 advertises low|high|max only; no medium tier.
      [[ "$EFFORT" =~ ^(low|high|max)$ ]] && supported=true
      ;;
    qwen3.8-max|deepseek-v4-flash-0731|deepseek-v4-pro-0813)
      [[ "$EFFORT" =~ ^(low|medium|xhigh)$ ]] && supported=true
      ;;
    *) supported=true ;;
  esac
  [[ "$supported" == true ]] || {
    echo "xask: effort '$EFFORT' is not supported by $SELECTED_MODEL_ID" >&2
    exit 1
  }
fi

if [[ "$SUBSTRATE" == sekhmet && -n "$EFFORT" && "$EFFORT" != low ]]; then
  echo "xask: sekhmet currently fixes effective effort at low; omit --effort or use low" >&2
  exit 1
fi

# Daybreak / gpt-5.4-mini hard-reject fast. Every other route pins fast by default
# (ChatGPT, spark, Token Plan Codex wrappers). grok/kimi keep the selection in
# plan JSON; those CLIs have no service_tier flag.
if [[ "$SELECTED_MODEL_ID" == gpt-daybreak-blue-latest || "$SELECTED_MODEL_ID" == gpt-5.4-mini ]]; then
  [[ -z "$SERVICE_TIER" || "$SERVICE_TIER" == default ]] || {
    echo "xask: $SELECTED_MODEL_ID does not advertise the fast service tier" >&2
    exit 1
  }
fi

# Explicit --spark is ChatGPT-Codex-only; native/Token Plan lanes reject it.
if [ "$SPARK_REQUESTED" = true ]; then
  case "$MODEL" in
    grok|qwen38|ds-flash|ds-pro|kimi|gemma|g|gemini)
      echo "xask: --spark cannot be combined with $MODEL" >&2
      exit 1
      ;;
  esac
fi

if [[ "$PLAN" == true ]]; then
  command -v jq >/dev/null 2>&1 || { echo "xask: jq is required for plan output" >&2; exit 1; }
  PLAN_QUERY="$QUERY | godspeed"
  plan_argv=(xask --provider "$PROVIDER" --substrate "$SUBSTRATE" --model-id "$SELECTED_MODEL_ID")
  [[ -n "$EFFORT" ]] && plan_argv+=(--effort "$EFFORT")
  [[ -n "$SERVICE_TIER" ]] && plan_argv+=(--service-tier "$SERVICE_TIER")
  [[ -n "$OUTPUT_LAST_MESSAGE" ]] && plan_argv+=(--output-last-message "$OUTPUT_LAST_MESSAGE")
  [[ "$RICH" == true ]] && plan_argv+=(--rich)
  plan_argv+=(--gs)
  [[ "$SCOPE" != "entire project" ]] && plan_argv+=(--scope "$SCOPE")
  if [[ -n "$REQUESTED_SKILL" ]]; then
    plan_argv+=(-- "$PLAN_QUERY" "$CONTEXT" "$REQUESTED_SKILL")
  elif [[ "$CONTEXT" != "No prior context." ]]; then
    plan_argv+=(-- "$PLAN_QUERY" "$CONTEXT")
  else
    plan_argv+=(-- "$PLAN_QUERY")
  fi
  plan_command=$(printf '%q ' "${plan_argv[@]}")
  plan_command=${plan_command% }
  if [[ "$PLAN_JSON" == true ]]; then
    plan_argv_json=$(jq -cn --args '$ARGS.positional' -- "${plan_argv[@]}")
    jq -n \
      --arg provider "$PROVIDER" --arg substrate "$SUBSTRATE" \
      --arg model_id "$SELECTED_MODEL_ID" --arg effort "${EFFORT:-default}" \
      --arg service_tier "${SERVICE_TIER:-default}" --arg command "$plan_command" \
      --argjson argv "$plan_argv_json" \
      '{schema_version:1,selection:{provider:$provider,substrate:$substrate,model_id:$model_id,effort:$effort,service_tier:$service_tier},argv:$argv,command:$command,executes:false}'
  else
    printf '%s\n' "$plan_command"
  fi
  exit 0
fi

# Bare `xask cdx` and `xask plan --provider chatgpt` default to stock xbreed.
# Explicit --spark / --substrate sekhmet select L3 xbrd-spark.

[ -n "$EFFORT" ] && EFFORT_FLAGS=(--effort "$EFFORT")
[ -n "$MODEL_ID" ] && MODEL_FLAGS=(--model "$MODEL_ID")
[ -n "$SERVICE_TIER" ] && SERVICE_TIER_FLAGS=(--service-tier "$SERVICE_TIER")
[ "$SPARK" = true ] && SPARK_FLAGS=(--spark)
[ "$REVIEW" = true ] && REVIEW_FLAGS=(--review)
[ "$FULL" = true ] && FULL_FLAGS=(--full)
[ "$GPT55" = true ] && GPT55_FLAGS=(--gpt55)
[ -n "$OUTPUT_LAST_MESSAGE" ] && OUTPUT_FLAGS=(--output-last-message "$OUTPUT_LAST_MESSAGE")
[ "$JSON" = true ] && JSON_FLAGS=(--json)

# --gs is an explicit transport marker for the always-on Godspeed loadout. A
# custom positional skill remains additive and is never discarded.

# Template selection. Token Plan + cdx reuse codex.md (IMCP envelope).
DISPATCH_MODEL="$MODEL"
case "$MODEL" in
  g) DISPATCH_MODEL="gemma" ;;
  cdx|qwen38|ds-flash|ds-pro) DISPATCH_MODEL="codex" ;;
esac

LANE=""
case "$MODEL" in
  grok) LANE="grok-cli" ;;
  qwen38) LANE="token-plan-qwen38" ;;
  ds-flash) LANE="token-plan-ds-flash" ;;
  ds-pro) LANE="token-plan-ds-pro" ;;
  kimi) LANE="kimi-code-cli" ;;
  cdx) LANE="stock-codex" ;;
  codex) LANE="stock-codex" ;;
  gemma|g|gemini) LANE="gemma-hvm" ;;
esac

# Real dir, not the invoked path — /usr/local/bin holds a shim symlink to this
# script, and TEMPLATE_DIR below is relative to the real install location.
SCRIPT_DIR="$_XASK_DIR"
# Dispatch-template dir. templates/ was briefly removed 2026-04-17 but restored
# the same day — dispatch substitution (gemini {{THINKING_BUDGET}} injection) is
# load-bearing for multi-level effort routing, and xask's raw-$QUERY fallback
# drops that behavior silently. Override via XBREED_DISPATCH_DIR if needed.
TEMPLATE_DIR="${XBREED_DISPATCH_DIR:-$SCRIPT_DIR/../templates/dispatch}"
TEMPLATE="$TEMPLATE_DIR/${DISPATCH_MODEL}.md"

if [ -z "$MODEL" ] || [ -z "$QUERY" ]; then
  echo "Usage: xask [-d|--debug] [-scp|--scope <scope>] [-r|--rich] [--spk|--spark] [-R|--review] [-F|--full] [--model-id <id>] [-e|--effort <level>] [-o|--output-last-message <FILE>] [--json] <model> \"<query>\" [\"<context>\"] [\"<skill>\"]" >&2
  exit 1
fi

# Build prompt from template
if [ -f "$TEMPLATE" ]; then
  # Map abstract effort tier → numeric thinkingBudget. Only gemini's dispatch
  # template substitutes this — gemini-CLI has no native --effort flag, so the
  # budget is injected as prompt-text directive. codex template doesn't
  # reference {{THINKING_BUDGET}}, so substitution is a no-op there.
  case "${EFFORT:-}" in
    low)    THINKING_BUDGET="512" ;;
    medium) THINKING_BUDGET="4096" ;;
    high)   THINKING_BUDGET="8192" ;;
    xhigh)  THINKING_BUDGET="16384" ;;
    max)    THINKING_BUDGET="32768" ;;
    ultra)  THINKING_BUDGET="65536" ;;
    *)      THINKING_BUDGET="default" ;;
  esac
  # One-pass literal renderer. Values travel through the environment so awk
  # does not reinterpret backslashes; direct printf avoids replacement-string
  # semantics for '&'. Inserted placeholder-like text is never rescanned.
  PROMPT=$(
    XASK_QUERY="$QUERY" XASK_CONTEXT="$CONTEXT" XASK_SCOPE="$SCOPE" \
      XASK_EFFORT="${EFFORT:-default}" XASK_THINKING_BUDGET="$THINKING_BUDGET" \
      awk '
        BEGIN {
          token[1]="{{QUERY}}"; value[1]=ENVIRON["XASK_QUERY"]
          token[2]="{{CONTEXT}}"; value[2]=ENVIRON["XASK_CONTEXT"]
          token[3]="{{SCOPE_BOUNDARY}}"; value[3]=ENVIRON["XASK_SCOPE"]
          token[4]="{{EFFORT}}"; value[4]=ENVIRON["XASK_EFFORT"]
          token[5]="{{THINKING_BUDGET}}"; value[5]=ENVIRON["XASK_THINKING_BUDGET"]
        }
        {
          rest=$0
          while (1) {
            nearest=0; which=0
            for (i=1; i<=5; i++) {
              at=index(rest, token[i])
              if (at && (!nearest || at < nearest)) { nearest=at; which=i }
            }
            if (!nearest) { printf "%s", rest; break }
            printf "%s%s", substr(rest, 1, nearest-1), value[which]
            rest=substr(rest, nearest + length(token[which]))
          }
          printf "\n"
        }
      ' "$TEMPLATE"
    printf '\034'
  )
  PROMPT="${PROMPT%$'\034'}"
else
  # Fail loud — silent raw-$QUERY fallback masked the xask-gate-regress-0420
  # install regression (templates/dispatch was not synced into ~/.local by
  # `make install` → xask collapsed to 16-byte raw prompt, stripping the
  # Inter-Model Protocol envelope + {{THINKING_BUDGET}} substitution + scope
  # framing). Invariant-preservation: degraded envelope must never ship
  # invisibly.
  echo "xask: dispatch template not found at $TEMPLATE" >&2
  echo "xask: templates must be at \$XBREED_DISPATCH_DIR or \$SCRIPT_DIR/../templates/dispatch" >&2
  echo "xask: run 'make install' from the xbreed repo to sync dispatch templates" >&2
  exit 1
fi

# Transport the quintessential directive on every provider lane. Stock xbreed
# additionally receives `--with godspeed`; direct provider CLIs have no skill
# flag, so the exact directive travels inline. Never substitute a compact form.
GODSPEED_DIRECTIVE_FILE="$(resolve_godspeed_directive)" || exit 1
GODSPEED_DIRECTIVE="$(<"$GODSPEED_DIRECTIVE_FILE")"
PROMPT="$(strip_trailing_godspeed_markers "$PROMPT")"
PROMPT="$GODSPEED_DIRECTIVE

---

$PROMPT | godspeed"

# Build argv identity for native / Token Plan / cdx lanes (debug + exec).
# Isolation: grok + Token Plan always drop titanium contamination vars.
# Debug ARGV uses <PROMPT> so multiline bodies do not break identity greps.
CODEX_BIN_SET=1
[[ -z "${CODEX_BIN+x}" ]] && CODEX_BIN_SET=0
DISPATCH_ARGV=()
DEBUG_ARGV=()
case "$MODEL" in
  grok)
    CODEX_BIN_SET=0
    if [ "$JSON" = true ] || [ -n "$OUTPUT_LAST_MESSAGE" ] || [ "$GPT55" = true ] \
      || [ "$REVIEW" = true ] || [ "$FULL" = true ]; then
      echo "xask: --json/-o/--gpt55/-R/-F are not grok-cli flags (use -e/--model-id; --json is Codex JSONL, not grok --output-format)" >&2
      exit 1
    fi
    GROK_EXTRA=()
    [ -n "$EFFORT" ] && GROK_EXTRA+=(--reasoning-effort "$EFFORT")
    [ -n "$MODEL_ID" ] && GROK_EXTRA+=(-m "$MODEL_ID")
    DISPATCH_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL grok --always-approve --no-subagents --verbatim "${GROK_EXTRA[@]}" -p "$PROMPT")
    DEBUG_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL grok --always-approve --no-subagents --verbatim "${GROK_EXTRA[@]}" -p "<PROMPT>")
    ;;
  qwen38|ds-flash|ds-pro)
    CODEX_BIN_SET=0
    if [ "$GPT55" = true ] || [ "$REVIEW" = true ] || [ "$FULL" = true ] || [ -n "$MODEL_ID" ]; then
      echo "xask: --gpt55/-R/-F/--model-id contaminate Token Plan (profile owns model; no ChatGPT -m)" >&2
      exit 1
    fi
    TP_EXTRA=()
    [ "$JSON" = true ] && TP_EXTRA+=(--json)
    [ -n "$OUTPUT_LAST_MESSAGE" ] && TP_EXTRA+=(-o "$OUTPUT_LAST_MESSAGE")
    [ -n "$EFFORT" ] && TP_EXTRA+=(-c "model_reasoning_effort=$EFFORT")
    if [[ "$SERVICE_TIER" == fast ]]; then
      TP_EXTRA+=(-c 'service_tier=fast')
    fi
    TP_BIN="codex-$MODEL"
    if ! command -v "$TP_BIN" >/dev/null 2>&1; then
      DISPATCH_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL codex-token-plan "$MODEL" exec
        --skip-git-repo-check --color never --ephemeral --sandbox workspace-write
        -c 'approval_policy="never"' "${TP_EXTRA[@]}" "$PROMPT")
      DEBUG_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL codex-token-plan "$MODEL" exec
        --skip-git-repo-check --color never --ephemeral --sandbox workspace-write
        -c 'approval_policy="never"' "${TP_EXTRA[@]}" "<PROMPT>")
    else
      DISPATCH_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL "$TP_BIN" exec
        --skip-git-repo-check --color never --ephemeral --sandbox workspace-write
        -c 'approval_policy="never"' "${TP_EXTRA[@]}" "$PROMPT")
      DEBUG_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL "$TP_BIN" exec
        --skip-git-repo-check --color never --ephemeral --sandbox workspace-write
        -c 'approval_policy="never"' "${TP_EXTRA[@]}" "<PROMPT>")
    fi
    ;;
  kimi)
    CODEX_BIN_SET=0
    if [ "$JSON" = true ] || [ -n "$OUTPUT_LAST_MESSAGE" ] || [ "$GPT55" = true ] \
      || [ "$REVIEW" = true ] || [ "$FULL" = true ]; then
      echo "xask: --json/-o/--gpt55/-R/-F are not kimi-cli flags (use -e low|high|max; --json is Codex JSONL, not kimi --output-format)" >&2
      exit 1
    fi
    # Effort travels envelope-text only ({{EFFORT}} in kimi.md) — the CLI has
    # no reasoning-effort flag. Always pin -m: kimi-code's ambient default_model
    # is kimi-for-coding (K2.7), which would silently violate the K3 route.
    # Default alias targets the OAuth-managed K3 (subscription metering); the
    # pay-as-you-go API-key provider stays reachable via --model-id
    # moonshotai/kimi-k3 (`kimi provider catalog add moonshotai`).
    KIMI_ALIAS="$MODEL_ID"
    case "$KIMI_ALIAS" in
      ""|kimi-k3|kimi-code) KIMI_ALIAS="kimi-code/k3" ;;
    esac
    # Note: plan output surfaces the catalog id (kimi-k3) while exec passes the
    # CLI-qualified alias (kimi-code/k3) — same model, different namespaces.
    # One-shot mode takes NO approval flag: the CLI rejects -p combined with
    # both --auto and -y/--yolo (session-mode concepts). Plain -p is the
    # supported non-interactive shape.
    DISPATCH_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL kimi -m "$KIMI_ALIAS" -p "$PROMPT")
    DEBUG_ARGV=(env -u CODEX_BIN -u XBRD_SPARK_MODEL kimi -m "$KIMI_ALIAS" -p "<PROMPT>")
    ;;
  cdx|codex)
    DISPATCH_ARGV=(xbreed ask codex --with "$SKILL" "${MODEL_FLAGS[@]}" "${SPARK_FLAGS[@]}"
      "${REVIEW_FLAGS[@]}" "${FULL_FLAGS[@]}" "${GPT55_FLAGS[@]}" "${EFFORT_FLAGS[@]}"
      "${SERVICE_TIER_FLAGS[@]}" "${OUTPUT_FLAGS[@]}" "${JSON_FLAGS[@]}" "$PROMPT")
    DEBUG_ARGV=(xbreed ask codex --with "$SKILL" "${MODEL_FLAGS[@]}" "${SPARK_FLAGS[@]}"
      "${REVIEW_FLAGS[@]}" "${FULL_FLAGS[@]}" "${GPT55_FLAGS[@]}" "${EFFORT_FLAGS[@]}"
      "${SERVICE_TIER_FLAGS[@]}" "${OUTPUT_FLAGS[@]}" "${JSON_FLAGS[@]}" "<PROMPT>")
    ;;
  gemma|g|gemini)
    DISPATCH_ARGV=(xbreed ask gemma --with "$SKILL" "${MODEL_FLAGS[@]}" "${EFFORT_FLAGS[@]}" "$PROMPT")
    DEBUG_ARGV=(xbreed ask gemma --with "$SKILL" "${MODEL_FLAGS[@]}" "${EFFORT_FLAGS[@]}" "<PROMPT>")
    ;;
esac

# Explicit --spark on cdx/codex → sekhmet (xbrd-spark). Inherit L3 CODEX_BIN.
# Never Token Plan, never grok, never xask-l3 (would recurse).
if [ "$SPARK" = true ]; then
  case "$MODEL" in
    cdx|codex)
      SPARK_MODEL="${MODEL_ID:-${XBRD_SPARK_MODEL:-gpt-5.3-codex-spark}}"
      case "$SPARK_MODEL" in
        gpt-5.6-sol|gpt-5.6-terra|gpt-5.6-luna|gpt-daybreak-blue-latest|gpt-reserve|\
        gpt-5.5|gpt-5.4|gpt-5.4-mini|gpt-5.3-codex-spark|codex-auto-review) ;;
        *)
          echo "xask: --spark model '$SPARK_MODEL' is not an L3 ChatGPT/Titanium id" >&2
          exit 1
          ;;
      esac
      command -v sekhmet >/dev/null 2>&1 || {
        echo "xask: --spark requires sekhmet on PATH (xbrd-spark)" >&2
        exit 1
      }
      LANE="sekhmet"
      if [ "$JSON" = true ] || [ -n "$OUTPUT_LAST_MESSAGE" ] || [ "$GPT55" = true ] \
        || [ "$REVIEW" = true ] || [ "$FULL" = true ]; then
        echo "xask: --json/-o/--gpt55/-R/-F are dropped by --spark (sekhmet has no those flags)" >&2
        exit 1
      fi
      SPARK_SERVICE_TIER="${SERVICE_TIER:-${XBRD_SPARK_SERVICE_TIER:-fast}}"
      DISPATCH_ARGV=(env XBRD_SPARK_MODEL="$SPARK_MODEL" XBRD_SPARK_SERVICE_TIER="$SPARK_SERVICE_TIER"
        sekhmet run --scope "$PWD" --task "$PROMPT")
      DEBUG_ARGV=(env XBRD_SPARK_MODEL="$SPARK_MODEL" XBRD_SPARK_SERVICE_TIER="$SPARK_SERVICE_TIER"
        sekhmet run --scope "$PWD" --task "<PROMPT>")
      ;;
  esac
fi

# Debug mode — gemma/codex keep legacy prompt dump; new lanes add LANE/ARGV/CODEX_BIN_SET.
if [ "$DEBUG" = true ]; then
  echo "=== XASK DEBUG ==="
  echo "MODEL: $MODEL"
  case "$MODEL" in
    grok|qwen38|ds-flash|ds-pro|kimi|cdx|codex)
      echo "LANE: $LANE"
      echo "ARGV: ${DEBUG_ARGV[*]}"
      echo "CODEX_BIN_SET=$CODEX_BIN_SET"
      ;;
  esac
  echo "MODE: $([ "$RICH" = true ] && echo RICH || echo CLEAN)"
  echo "SPARK: $SPARK"
  echo "REVIEW: $REVIEW"
  echo "EFFORT: ${EFFORT:-<unset>}"
  echo "MODEL_ID: ${MODEL_ID:-<default>}"
  echo "PROVIDER: $PROVIDER"
  echo "SUBSTRATE: $SUBSTRATE"
  echo "SERVICE_TIER: ${SERVICE_TIER:-<default>}"
  echo "SCOPE: $SCOPE"
  echo "SKILL: $SKILL"
  echo "TEMPLATE: $TEMPLATE"
  printf 'CONSTRUCTED PROMPT (%s bytes):\n' "$(printf '%s' "$PROMPT" | wc -c)"
  echo "---"
  printf '%s\n' "$PROMPT"
  echo "---"
  exit 0
fi

t_start_s=$(date +%s.%N)

# Dispatch — contamination-aware per model
# gemma / g / gemini (legacy) → local HVM bridge (gemma-hvm). --rich is a no-op
# for gemma (no cloud settings tree); kept accepted so old flags don't fail.
# grok / Token Plan / kimi → bash-exec native CLI with CODEX_BIN/XBRD_SPARK_MODEL cleared.
case "$MODEL" in
  gemma|g|gemini)
    if [ "$RICH" = true ]; then
      echo "xask: --rich is ignored for local gemma/HVM lane" >&2
    fi
    "${DISPATCH_ARGV[@]}"
    ;;
  codex|cdx)
    "${DISPATCH_ARGV[@]}"
    ;;
  grok|qwen38|ds-flash|ds-pro|kimi)
    "${DISPATCH_ARGV[@]}"
    ;;
  *)
    echo "Unknown model: $MODEL. Use gemma (g), codex/cdx, grok, qwen38, ds-flash, or kimi." >&2
    exit 1
    ;;
esac
RC=$?

if [ -n "${XBREED_BENCH_LOG:-}" ]; then
  t_end_s=$(date +%s.%N)
  wall_s=$(awk -v s="$t_start_s" -v e="$t_end_s" 'BEGIN{printf "%.3f", e - s}')
  t_complete_iso=$(date -Iseconds)
  bench_log="$XBREED_BENCH_LOG"
  if [[ -L "$bench_log" || ( -e "$bench_log" && ! -f "$bench_log" ) ]]; then
    echo "xask: refusing non-regular or symlink bench log: $bench_log" >&2
    RC=1
  else
    if [[ ! -e "$bench_log" ]]; then
      (umask 077; set -o noclobber; : >"$bench_log") 2>/dev/null || true
    fi
    if [[ -L "$bench_log" || ! -f "$bench_log" ]]; then
      echo "xask: refusing non-regular or symlink bench log: $bench_log" >&2
      RC=1
    else
      bench_line=$(jq -cn \
        --arg t "$t_complete_iso" --arg cli "$MODEL" --argjson wall "$wall_s" \
        --argjson rc "$RC" --arg effort "${EFFORT:-default}" \
        --arg teammate "${XBREED_BENCH_TEAMMATE:-null}" \
        '{t_complete_iso:$t,cli:$cli,wall_s:$wall,exit_code:$rc,effort:$effort,teammate:$teammate}') || RC=1
      [[ -n "${bench_line:-}" ]] && printf '%s\n' "$bench_line" >>"$bench_log"
    fi
  fi
fi

exit $RC
