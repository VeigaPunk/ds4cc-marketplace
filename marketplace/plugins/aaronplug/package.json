{
  "name": "@veigapunk/aaron",
  "version": "0.2.0",
  "type": "module",
  "description": "aaron — Bash-invocable CLI tool for books (lib*) and papers (arxiv/s2/sci*). fnm/Node only. Not an agent, not MCP.",
  "main": "./build/aaron.js",
  "bin": {
    "aaron": "./build/aaron.js"
  },
  "homepage": "https://github.com/VeigaPunk/aaronplug",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "link-local": "npm run build && npm link",
    "lint": "eslint 'src/**/*.{js,ts,json}'",
    "lint:fix": "eslint --fix 'src/**/*.{js,ts,json}'",
    "format": "prettier --write 'src/**/*.{js,ts,css,md,json}' --config ./.prettierrc",
    "clean": "rimraf ./build ./standalone-executables"
  },
  "keywords": [
    "aaron",
    "cli",
    "tool",
    "books",
    "papers",
    "scout-tool",
    "fnm",
    "node"
  ],
  "author": "VeigaPunk",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/VeigaPunk/aaronplug.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/content-disposition": "^0.5.9",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^63.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@opendocsg/pdf2md": "^0.2.6",
    "content-disposition": "^1.0.1",
    "linkedom": "^0.18.12",
    "meow": "^14.0.0",
    "nanoid": "^5.1.6"
  }
}
